# TLS for the scale-to-zero Fargate setup, where the public IP (and
# therefore the hostname) changes every wake. Uses sslip.io — a free
# service where `<label>.<ip-with-dashes>.sslip.io` resolves to that literal
# IP — combined with Caddy's on-demand TLS to auto-issue a real Let's
# Encrypt cert for whatever sslip.io hostname is actually requested, with
# no static domain purchase and no per-wake DNS updates needed.
#
# Mirrors the two-domain split from ../../deploy/Caddyfile (app vs api),
# just using two sslip.io labels sharing the one dynamic IP instead of two
# real domains.
{
	on_demand_tls {
		ask http://localhost:9000/ask
	}
}

# Internal-only "ask" endpoint: on-demand TLS must validate the requested
# hostname before Caddy will request a cert for it, otherwise anyone could
# point arbitrary hostnames at this IP and burn our Let's Encrypt quota.
# Restrict to our two expected sslip.io labels only.
#
# NOTE: the `query` matcher does NOT do wildcard globbing on values (that's
# only a `path`/`header` matcher feature) — an earlier version of this file
# used `query domain=app.*.sslip.io` expecting glob behavior, which in fact
# only matches the literal string "app.*.sslip.io" and therefore never
# matched a real IP-derived hostname, silently failing every on-demand TLS
# request. Use the CEL `expression` matcher with a real regex instead.
:9000 {
	@allowed {
		expression {query.domain}.matches("^(app|api)\\.[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}\\.sslip\\.io$")
	}
	respond @allowed 200
	respond 403
}

:443 {
	tls {
		on_demand
	}

	@api host api.*.sslip.io
	handle @api {
		encode zstd gzip
		request_body {
			max_size 25MB
		}
		reverse_proxy localhost:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			-Server
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy localhost:3000
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}
	}
}

:80 {
	redir https://{host}{uri} permanent
}
