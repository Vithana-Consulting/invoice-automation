aws_region   = "us-east-1"
project      = "vithana"
allowed_cidr = "0.0.0.0/0" # restrict to your office/VPN IP, e.g. "203.0.113.4/32"

mysql_root_password        = "CHANGE_ME"
mysql_password              = "CHANGE_ME"
jwt_secret_key               = "CHANGE_ME"
admin_api_key                = "CHANGE_ME"
integration_encryption_key   = "CHANGE_ME"
llm_api_key                  = "sk-..."
llamaparse_api_key           = ""
google_client_id             = ""
google_client_secret         = ""

# Leave blank on first apply — ECR repos don't exist yet. After the first
# `terraform apply`, run scripts/build-and-push.sh, then set these to the
# printed image URIs and re-apply.
backend_image  = ""
frontend_image = ""
caddy_image    = ""

app_desired_count = 0
db_desired_count  = 0
