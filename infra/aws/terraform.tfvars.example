aws_region = "us-east-1"
project    = "vithana"

mysql_root_password        = "CHANGE_ME"
mysql_password              = "CHANGE_ME"
jwt_secret_key               = "CHANGE_ME"
admin_api_key                = "CHANGE_ME"
integration_encryption_key   = "CHANGE_ME"
llm_api_key                  = "sk-..."
llamaparse_api_key           = ""
google_client_id             = ""
google_client_secret         = ""

# Leave blank on first apply — the ECR repo doesn't exist yet. After the
# first `terraform apply`, run scripts/build-and-push.sh, then set this to
# the printed image URI and re-apply.
app_image = ""

# S3 bucket for invoice attachments (App Runner has no persistent volume).
# Leave blank on first apply — the bucket is created by Terraform; nothing
# to set here unless you want a specific name (s3.tf picks one automatically).

db_desired_count = 0
